# ============================================================================
# TAS — environment (PRD §39.14 + эррата Э6/Э9)
# Скопировать в .env и заполнить. Секреты никогда не коммитить.
# Приложение валидирует env zod-схемой (packages/shared/src/config.ts) и
# падает на старте с понятным списком проблем.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Ports / URLs (Э5: api :4000, bot :4100 отдельным сервисом) --------------
APP_PORT=4000            # apps/api (Fastify)
BOT_PORT=4100            # apps/bot (Fastify; валидируется только apps/bot; в prod наружу НЕ публикуется)
WEB_PORT=3000            # apps/web (Next.js)
PUBLIC_BASE_URL=http://localhost:3000

# --- Database / Cache --------------------------------------------------------
# dev-дефолт соответствует infra/compose.base.yml
DATABASE_URL=postgresql://tas:tas_dev@localhost:5432/tas
REDIS_URL=redis://localhost:6379

# --- Telegram (§24.2) ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=                  # от @BotFather (prod-бота)
TELEGRAM_WEBHOOK_SECRET=             # openssl rand -hex 24; сверяется с header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_BOT_USERNAME=               # username бота без @, [A-Za-z0-9_]

# --- S3 (файлы лид-магнитов, картинки пинов) ----------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI (§14, §39.11; OpenAI-совместимый адаптер) -----------------------------
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# --- Security (Э6) -------------------------------------------------------------
JWT_SECRET=                          # openssl rand -hex 32 (мин. 32 символа)
JWT_TTL=15m
ENCRYPTION_KEY=                      # Э6: AES-256-GCM ключ для TOTP-секретов; openssl rand -base64 32

# --- Attribution (формат токена фиксирован, не менять без approval) ------------
ATTRIBUTION_TOKEN_PREFIX=t1
NANOID_LEN=10

# --- Limits (§13.2: лимиты отправки с запасом до 30 msg/s Telegram) ------------
SENDER_RATE_PER_SEC=25
DAILY_MSG_CAP_PER_USER=1

# --- Economics (Э9: usd_equiv = stars_amount × STAR_USD_RATE) -------------------
STAR_USD_RATE=0.013

# --- Monitoring / backups -------------------------------------------------------
SENTRY_DSN=                          # опционально
BACKUP_S3_BUCKET=                    # опционально (M10)

# --- CI flag ----------------------------------------------------------------------
GITLEAKS=enabled

# --- Pinterest (V1 — НЕ используется в MVP, оставить пустым) ----------------------
PINTEREST_ACCESS_TOKEN=
PINTEREST_AD_ACCOUNT_ID=

# --- Goals (пороги гипотезы Phase 2, PRD §30.4) ------------------------------------
GOALS_ACTIVATION=0.4
GOALS_START_TO_CUSTOMER=0.025
GOALS_BLOCK_RATE=0.02
