# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Search URL. Open it in Avito, choose sorting by newest if available, and copy the URL.
# The bot takes the first result on this page as the latest listing.
AVITO_SEARCH_URL=https://www.avito.ru/moskva?q=велосипед

# Persistent state
DATABASE_PATH=data/bot.sqlite3

# The bot makes at most one request per this many seconds.
# Minimum is 60; 300–900 seconds is recommended.
POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=20
MAX_BACKOFF_SECONDS=21600

# Honest User-Agent. Replace the contact address with your own.
AVITO_USER_AGENT=AvitoLatestBot/1.0 (+mailto:you@example.com)

# Optional. Restrict subscriptions to these numeric Telegram chat IDs.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789
